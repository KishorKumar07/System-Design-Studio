# AI providers — Gemini is primary, Groq is the automatic fallback if Gemini
# errors out or exhausts retries (see src/lib/ai/client.ts)
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Guardrails
EVAL_RATE_LIMIT_PER_HOUR="10"
