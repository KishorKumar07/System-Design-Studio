# Postgres (Neon/Supabase/local)
DATABASE_URL="postgresql://postgres:devpass@localhost:5434/system_design_studio"

# Auth.js
AUTH_SECRET="generate-with: npx auth secret"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Required in production behind a reverse proxy (Nginx/Jenkins deploy) so
# Auth.js builds correct callback URLs. Not needed for local `next dev`.
AUTH_URL="https://your-domain.example"

# AI providers — Gemini is primary, Groq is the automatic fallback if Gemini
# errors out or exhausts retries (see src/lib/ai/client.ts)
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Guardrails
EVAL_RATE_LIMIT_PER_HOUR="10"

# Error tracking (optional) — leave unset and Sentry is a safe no-op.
# https://sentry.io -> create a free project -> Settings -> Client Keys (DSN)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed if you want source maps uploaded on build (nice-to-have, not required)
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
