generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth (Auth.js) ──────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for OAuth-only accounts
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  designs         Design[]
  evaluationLogs  EvaluationLog[]
}

enum Role {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Domain ───────────────────────────────────────────────────────────────

model Problem {
  id                        String   @id @default(cuid())
  slug                      String   @unique
  title                     String
  difficulty                Difficulty
  category                  String
  statement                 String   @db.Text
  functionalRequirements    String[]
  nonFunctionalRequirements String[]
  constraints               String[]
  // reference numbers used to sanity-check the user's capacity checkpoint,
  // e.g. { "expectedDAU": 5000000, "readWriteRatio": "100:1" }
  referenceScale            Json?
  createdAt                 DateTime @default(now())

  designs Design[]
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Design {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  title     String   @default("Untitled design")

  // current working state
  nodes           Json
  edges           Json
  capacityInputs  Json?

  // most recent evaluation, denormalized for fast list/dashboard rendering
  latestScore     Int?
  latestVerdict   String?
  latestEvaluation Json?

  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem  Problem         @relation(fields: [problemId], references: [id], onDelete: Restrict)
  attempts DesignAttempt[]

  @@index([userId])
  @@index([isPublic])
}

// immutable snapshot, written on every graded submission — lightweight history,
// not a full diff/version-graph engine
model DesignAttempt {
  id         String   @id @default(cuid())
  designId   String
  nodes      Json
  edges      Json
  capacityInputs Json?
  evaluation Json
  score      Int
  createdAt  DateTime @default(now())

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@index([designId])
}

// one row per AI evaluation call — backs the per-user rate limiter (count rows
// in the trailing window) and gives a cost/usage audit trail for governance
model EvaluationLog {
  id             String   @id @default(cuid())
  userId         String
  designId       String?
  provider       String
  promptTokens   Int
  completionTokens Int
  costUsd        Decimal  @db.Decimal(10, 6)
  succeeded      Boolean
  fallbackUsed   Boolean  @default(false)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
